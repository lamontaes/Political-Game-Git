{
  "maxDays": 14,
  "patterns": {
    "scope": "^(AGENTS|ARCHITECTURE)\\.md$|^docs/(README|ROADMAP)\\.md$|^docs/(roadmap|coordination|design|packages|work-orders)/.*\\.md$|^docs/(reports|grading)/[^/]+\\.md$|^docs/pool/README\\.md$|^(src/(core2|director|english|bench)|desktop|scripts/[^/]+)/README[^/]*\\.md$|^\\.agents/skills/[^/]+/SKILL\\.md$|^\\.agents/rules/.*\\.md$|^\\.github/PULL_REQUEST_TEMPLATE\\.md$",
    "record": "^docs/(reports|grading)/([^/]*(\\d{4}-\\d{2}|batch|law-wiring-table)|coverage\\.md$)|PULL_REQUEST_TEMPLATE",
    "logs": "OWNER-DECISIONS|DECISION-REGISTER|prior-rulings|doc-freshness",
    "overruled": [
      "replac|withdrawn|supersed|overrul|no longer|history|banned|stale",
      "i"
    ],
    "history": ["^> \\*\\*History\\.\\*\\*|^Superseded by ", "m"],
    "stamp": "^Current as of (\\d{4}-\\d{2}-\\d{2}) \\(.+\\)",
    "token": [
      "`([^`\\s]+)`|(?:^|[\\s(])((?:src|docs|scripts|\\.agents)/[\\w./<>*{}-]*[\\w>}*/])",
      "g"
    ],
    "skipToken": "[*<>{}$~]|^/|^https?:|-N\\b|\\bN\\.|^[^/]*$",
    "rooted": "^(src|docs|scripts|data|tests|art|desktop|\\.agents|\\.claude|\\.github)/",
    "fileLike": "\\.(md|mjs|ts|tsx|js|json|css|yml|html|py|txt)$|/$",
    "openPr": ["\\b(open|pending|waiting|in review)\\b", "i"]
  },
  "banned": [
    "only the CTO merges",
    "merging stays with the CTO",
    "CTO never merges",
    "merged by the CTO",
    "Sonnet is the only",
    "Sonnet[- ]only",
    "no Opus",
    "no skip-ahead",
    "10,000[- ](?:person |people )?(?:town )?cap",
    "two documents,? one public[- ]domain",
    "Opus pillar",
    "(?:keeps?|update|in) (?:its|their|your) (?:own )?status file",
    "GitHub Project is the",
    "reporters?(?: and outlet owners)? (?:may not|can't|cannot|do not) hold office"
  ]
}
