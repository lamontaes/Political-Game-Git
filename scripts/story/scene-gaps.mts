// Which of the director's scene arcs the scene-talk bank can word: every purpose in src/director/data/purpose-arcs.json,
// the pieces the bank holds for it, and the state and reply moves the arc asks for that no piece answers.
// Usage: node --import tsx scripts/story/scene-gaps.mts > docs/story/scene-gaps.md
import { readFileSync } from "node:fs";

type Arc = { state?: string; stateMoves?: string[]; replies?: string[] };
const arcs = (
  JSON.parse(readFileSync("src/director/data/purpose-arcs.json", "utf8")) as {
    purposes: Record<string, Arc>;
  }
).purposes;
const bank = (
  JSON.parse(readFileSync("data/english/parts/scene-talk.json", "utf8")) as {
    parts: {
      uses: { purpose?: string; step?: string; move?: string; role?: string }[];
    }[];
  }
).parts;
const count = new Map<string, number>();
const moves = new Map<string, Set<string>>();
for (const part of bank)
  for (const use of part.uses) {
    if (!use.purpose) continue;
    const base = use.purpose.split(".")[0]!;
    count.set(base, (count.get(base) ?? 0) + 1);
    if (!moves.has(base)) moves.set(base, new Set());
    moves.get(base)!.add(`${use.step}:${use.move}:${use.role}`);
  }
const rows = Object.entries(arcs).map(([purpose, arc]) => {
  const have = moves.get(purpose) ?? new Set<string>();
  const need = [
    ...(arc.stateMoves ?? [arc.state ?? ""]).map(
      (move) => `state:${move}:asker`,
    ),
    ...(arc.replies ?? []).map((move) => `reply:${move}:asked`),
  ];
  return {
    purpose,
    pieces: count.get(purpose) ?? 0,
    missing: need
      .filter((key) => !have.has(key))
      .map((key) => key.split(":").slice(0, 2).join(" ")),
  };
});
const silent = rows.filter((row) => row.pieces === 0);
const partial = rows.filter((row) => row.pieces > 0 && row.missing.length);
const out: string[] = [
  "# Scene arcs the bank cannot word",
  "",
  "Generated by `node --import tsx scripts/story/scene-gaps.mts`. A scene arc (`src/director/data/purpose-arcs.json`) is worded from pieces of `data/english/parts/scene-talk.json` whose use names its purpose, step, move and role. An arc with no piece is a scene the director can stage and the English engine cannot say; an arc missing a move cannot offer that move's reply or statement.",
  "",
  `${rows.length} arcs: ${silent.length} with no piece, ${partial.length} with pieces but a state or reply move no piece answers.`,
  "",
  "## No piece at all",
  "",
  ...silent.map((row) => `- \`${row.purpose}\``),
  "",
  "## Pieces, but a move no piece answers",
  "",
  ...partial.map(
    (row) =>
      `- \`${row.purpose}\` (${row.pieces} pieces): ${row.missing.join(", ")}`,
  ),
  "",
];
process.stdout.write(out.join("\n"));
