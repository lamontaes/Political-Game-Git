{
  "register": "newscast",
  "description": "Spoken news on TV and radio: the anchor opening a broadcast, handing to a reporter and closing; the reporter in the field; and the stories the game's records make (an election night, a candidate filing, a vote or a law taking effect, a business closing or hiring, a hazard warning, a death). Every part is a whole sentence said in public-domain federal records (the Daily Compilation of Presidential Documents with its broadcast interviews, hearings, federal agencies' releases and briefings), with record words as slots. Commercial news gives patterns only.",
  "slots": {
    "name": "A person, by name, from the records (the anchor, the reporter, a candidate, an official, someone who died).",
    "program": "The broadcast's name, from the station record.",
    "place": "A place, from the place records.",
    "topic": "What the story is about, from the event record.",
    "claim": "What officials say, from the event record.",
    "number": "A count from the event record.",
    "amount": "A larger count from the event record, as people say it (\"12,000\", \"2 million\").",
    "time": "A time from the record (\"7 p.m.\").",
    "percent": "A share from the results or economy record, as a number such as 52.",
    "votes": "A vote margin from the results record.",
    "opponent": "The other candidate, from the contest record.",
    "office": "The office, from the contest or office record.",
    "pronoun": "His, her or their, from the person's record.",
    "deadline": "A date from the record, as people say it.",
    "when": "When it happens, from the record (\"today\", \"on Friday\").",
    "count": "A vote count such as 5 to 2, from the vote record.",
    "measure": "The measure, as its record names it.",
    "subject": "The business, from the business record.",
    "age": "An age, computed from the birth record.",
    "years": "A count of years, computed from dated records.",
    "alert": "A weather alert from the hazard record, as the Weather Service names it (\"Tornado Watch\").",
    "until": "When the alert ends, from the hazard record (\"5 PM EDT\")."
  },
