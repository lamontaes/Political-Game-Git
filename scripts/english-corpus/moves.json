{
  "schema": "english-moves/1",
  "note": "The one shared list of moves and situation keys that ties the director's situation catalog (src/director/data/situation-types.json) to the English engine's banks (data/english/parts/). A move is one thing a person does with a line, situation-blind; a key is the kind of moment a situation is, shared across situations (a funeral, an assassination and a lost election are all loss). The rules below tag every bank part with its shared move and, where the sentence fits only one kind of moment, its key: scripts/english-corpus/tag-moves.ts applies them in order (first match wins) and writes each part's `tag`. Structure only: no rule holds a sentence; a `text` pattern only sorts a mined sentence by what it already says.",
  "moves": {
    "greet": "Open an exchange with a hello or a salutation.",
    "introduce": "Say who someone is, or who the speaker is.",
    "address-chair": "Speak to the person presiding before speaking to a body.",
    "ask": "Ask a question.",
    "answer": "Answer a question.",
    "tell": "Say something the speaker's own record holds.",
    "deliver-news": "Tell someone something that happened that they may not know.",
    "react": "A short reaction to what was just said.",
    "beat": "The narrator says what is happening around the people talking, between their lines.",
    "recall": "Bring up something shared from the past.",
    "condole": "Say one is sorry for a loss.",
    "congratulate": "Recognize someone's win or honor.",
    "comfort": "Reassure someone in a hard moment.",
    "thank": "Thank someone.",
    "apologize": "Say one is sorry for what one did.",
    "confess": "Admit something.",
    "deflect": "Turn a question aside without answering it.",
    "lie": "Say something false about the speaker's own record.",
    "agree": "Agree with what was said.",
    "disagree": "Disagree with what was said.",
    "refuse": "Turn down a demand.",
    "decline": "Turn down an offer or a request.",
    "confront": "Press someone on what they did.",
    "blame": "Say who caused something.",
    "request": "Ask someone to do something.",
    "offer": "Offer to do something.",
    "promise": "Commit to doing something.",
    "warn": "Tell of a danger ahead.",
    "farewell": "Say goodbye.",
    "close": "End a speech, a turn or an exchange.",
    "call-to-order": "Run a body's procedure: open a meeting, recognize a speaker, rule on order.",
    "put-question": "Put a motion to a vote.",
    "announce-result": "Say how a vote, a race or a motion came out.",
    "narrate": "The narrator's line: where the player is and who is there.",
    "headline": "A news story's headline.",
    "enact": "A law's enacting words.",
    "title": "A law's title or a section's heading.",
    "provision": "A law's operative text.",
    "record": "A body's minutes recording what happened.",
    "notice": "A public notice's heading and text.",
    "control-name": "The name of a choice the player can take.",
    "plea": "Ask again, from the heart: what it means to the asker.",
    "press": "Ask again, harder: hold the other to the point.",
    "threaten": "Say what it will cost the other to refuse.",
    "boast": "Claim credit or strength for oneself.",
    "bargain": "Offer a condition or a trade.",
    "relent": "Give way after holding out.",
    "withdraw": "Go back on something one said before.",
    "accept": "Take the other's answer as final.",
    "stall": "Put off an answer.",
    "leave": "Ends the exchange and walks away: the talk stops without an answer.",
    "deny": "Says a claim is false."
  },
  "keys": {
    "loss": "Someone or something is lost: a death, a lost job, a lost race, an eviction.",
    "threat": "Something bad may happen: an accusation, a scandal, a recall, a danger.",
    "honor": "Someone is honored: a win, an appointment, an award, a celebration.",
    "news-received": "Someone learns of something that happened elsewhere.",
    "favor-asked": "Someone asks another for something.",
    "vote-wanted": "Someone wants a vote: on a measure or in a race.",
    "arrival": "Someone or something new arrives: a birth, a first day, a first meeting.",
    "departure": "Someone leaves: a move, a last day, a parting.",
    "routine": "The ordinary run of a day or a body's business."
  },
  "endpoints": {
    "money": "The scene ends on a dollar: a job, a rent, a payment, a law's cost reaching someone.",
    "bill": "The scene ends on a bill or a law: a vote, a signing, a veto, a hearing.",
    "political": "The scene ends on political life: a race, an office, a recall, the press.",
    "personal": "The scene ends on a person's own life: family, friends, health, home."
  },
  "registers": {
    "note": "The coverage table's register is the bank's register; the address bank is split by the occasion each part names (uses[].subject), since a floor speech and a concession are different registers in one file. A narrated or written register (the memoir, the scene narration, a headline, a law, the minutes) is not spoken by a role: its cells are the situation's narrator cells, one per move the register carries.",
    "splitBySubject": ["address"],
    "narrated": {
      "journal": ["tell", "recall"],
      "scene-words": ["narrate", "deliver-news"],
      "headlines": ["headline"],
      "news": ["deliver-news", "announce-result"],
      "newspaper-ledes": ["deliver-news"],
      "legislation": ["enact", "title", "provision"],
      "minutes": ["record", "announce-result"],
      "notice": ["notice"],
      "winning-losing": ["announce-result"]
    }
  },
