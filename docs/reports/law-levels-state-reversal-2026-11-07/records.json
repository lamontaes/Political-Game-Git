        "number": "S1",
        "spoken": "S1",
        "title": "A bill for an act to decide whether local governments may make their own rules on limits on rent increases and to require new housing developments to include affordable homes.",
        "purpose": "an end to affordable home requirements in new developments",
        "sponsor": "Lee Freeman",
        "sections": [
          {
            "index": 0,
            "key": "law:local-power:rent-stabilization",
            "text": "Section 1. Be it enacted by the Senate and General Assembly of the State of New Jersey. That each city, town and county may make its own rules on limits on rent increases, by ordinance.",
            "authority": {
              "allowed": true,
              "warning": "none",
              "reason": "within-own-power"
            },
            "estimate": {
