+// PRIVATE DIAGNOSTIC ONLY: no World fields or writer results change.
+type MonthlyCostFrame = { started: number; children: number };
+type MonthlyCostRow = {
+  calls: number;
+  failures: number;
+  inclusiveMs: number;
+  exclusiveMs: number;
+};
+const monthlyCostStack: MonthlyCostFrame[] = [];
+const monthlyCostRows: Record<string, MonthlyCostRow> = {};
+export function runMonthlyCostDiagnostic<T>(key: string, action: () => T): T {
+  const frame = { started: performance.now(), children: 0 };
+  monthlyCostStack.push(frame);
+  let failed = true;
+  try {
+    const result = action();
+    failed = false;
+    return result;
+  } finally {
+    const elapsed = performance.now() - frame.started;
+    monthlyCostStack.pop();
+    const row = (monthlyCostRows[key] ??= {
+      calls: 0,
+      failures: 0,
+      inclusiveMs: 0,
+      exclusiveMs: 0,
+    });
+    row.calls++;
+    row.failures += Number(failed);
+    row.inclusiveMs += elapsed;
+    row.exclusiveMs += elapsed - frame.children;
+    const parent = monthlyCostStack.at(-1);
+    if (parent) parent.children += elapsed;
+  }
+}
+export function monthlyCostDiagnostic() {
+  return monthlyCostRows;
+}
+
 const PREFIX = "player-monthly-money:";
 
