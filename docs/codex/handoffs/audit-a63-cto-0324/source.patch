diff --git a/src/simulation/macro-economy/monthly-innovations.test.ts b/src/simulation/macro-economy/monthly-innovations.test.ts
new file mode 100644
index 000000000..2e4e90be9
--- /dev/null
+++ b/src/simulation/macro-economy/monthly-innovations.test.ts
@@ -0,0 +1,72 @@
+import { describe, expect, it } from "vitest";
+import { SeededRng } from "../rng";
+import {
+  drawInnovations,
+  NO_IMPULSES,
+  START_ERA,
+  stepMonth,
+  type MacroMonthlyState,
+} from "./kernel";
+
+const saved: MacroMonthlyState = {
+  growthPct: 2,
+  unemploymentPct: 4.6,
+  inflationPct: 2.7,
+  realOutputIndex: 100,
+  priceIndex: 100,
+};
+
+function tenYears(seed: string, recordedPriceImpulse = false) {
+  const rng = new SeededRng(seed);
+  let state = saved;
+  const path: MacroMonthlyState[] = [];
+  for (let month = 0; month < 120; month += 1) {
+    state = stepMonth(
+      state,
+      drawInnovations(rng.fork(`month:${month}`)),
+      recordedPriceImpulse && month === 24
+        ? { ...NO_IMPULSES, pricePp: 1 }
+        : NO_IMPULSES,
+      START_ERA,
+    );
+    path.push(state);
+    // The same saved state resumes without an unexplained increment.
+    if (month === 59) state = JSON.parse(JSON.stringify(state));
+  }
+  return path;
+}
+
+describe("A63 monthly innovations", () => {
+  it("returns zero without consuming the random stream", () => {
+    const rng = new SeededRng("a63-no-stream");
+    const untouched = new SeededRng("a63-no-stream");
+    expect(drawInnovations(rng)).toEqual({
+      growth: 0,
+      unemployment: 0,
+      inflation: 0,
+    });
+    expect(rng.next()).toBe(untouched.next());
+  });
+
+  it("keeps the same 120-month path for the same saved state and era in two seeds", () => {
+    const first = tenYears("a63-path-a");
+    const second = tenYears("a63-path-b");
+    expect(first).toHaveLength(120);
+    expect(second).toEqual(first);
+    for (const month of first) {
+      expect(month.realOutputIndex).toBeGreaterThan(0);
+      expect(month.priceIndex).toBeGreaterThan(0);
+      expect(Number.isFinite(month.unemploymentPct)).toBe(true);
+    }
+  });
+
+  it("preserves an actual input impulse without replacing it with noise", () => {
+    const plain = tenYears("a63-path-a");
+    const changed = tenYears("a63-path-b", true);
+    expect(changed.slice(0, 24)).toEqual(plain.slice(0, 24));
+    expect(changed[24]!.inflationPct - plain[24]!.inflationPct).toBe(1);
+    expect(changed[24]!.priceIndex).toBeGreaterThan(plain[24]!.priceIndex);
+    expect(changed[24]!.growthPct).toBe(plain[24]!.growthPct);
+    expect(changed[24]!.unemploymentPct).toBe(plain[24]!.unemploymentPct);
+  });
+});
