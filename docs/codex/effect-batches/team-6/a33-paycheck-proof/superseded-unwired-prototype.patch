+/** A caller must supply an admitted levy and its real observed-pay event.
+ * No label-based wage mapping, synthetic earnings or second withholding is
+ * inferred here. The caller passes the existing assessment dispatcher to keep
+ * tax-policy independent of the effects/registry/tax import cycle.
+ */
+export function recordPaycheckTaxAssessment(
+  world: World,
+  outcomeId: EntityId,
+  binding: {
+    readonly proposalId: EntityId;
+    readonly questionKey: string;
+    readonly sourceEventId: EntityId;
+  },
+  dispatchAssessment: (world: World, context: LawConsequenceContext) => World,
+):
+  | {
+      readonly kind: "applied";
+      readonly world: World;
+      readonly baseId: EntityId;
+    }
+  | {
+      readonly kind: "unavailable";
+      readonly world: World;
+      readonly reason: string;
+    } {
+  const unavailable = (reason: string) => ({
+    kind: "unavailable" as const,
+    world,
+    reason,
+  });
+  const outcome = recordById(world.history.resourceTransferOutcomes, outcomeId);
+  const flow = outcome
+    ? recordById(world.history.resourceFlows, outcome.resourceFlowId)
+    : undefined;
+  const work =
+    flow?.basisReference.kind === "work"
+      ? recordById(
+          world.history.workRelationships,
+          flow.basisReference.workRelationshipId,
+        )
+      : undefined;
+  if (
+    !outcome ||
+    !flow ||
+    !work ||
+    flow.source.kind !== "organization" ||
+    flow.recipient.kind !== "person" ||
+    work.organizationId !== flow.source.organizationId ||
+    work.personId !== flow.recipient.personId ||
+    !world.people[work.personId] ||
+    flow.sequence >= outcome.sequence ||
+    work.sequence >= outcome.sequence ||
+    outcome.occurredAt !== world.currentDate ||
+    (outcome.status !== "completed" && outcome.status !== "partial") ||
+    outcome.transferredAmount.minorUnits <= 0
+  )
+    return unavailable(
+      "No current recorded positive payment to its actual worker.",
+    );
+  const proposal = recordById(
+    world.history.taxProposals ?? [],
+    binding.proposalId,
+  );
+  const question = Object.values(world.policyCatalog.propositions).find(
+    (entry) => entry.stableKey === binding.questionKey,
+  );
+  const law =
+    proposal && question
+      ? lawInForce(
+          world,
+          proposal.jurisdictionId,
+          question.id,
+          outcome.occurredAt,
+        )
+      : null;
+  const policy = proposal
+    ? effectiveTaxPolicy(
+        world,
+        proposal.jurisdictionId,
+        proposal.terms.seriesKey,
+        outcome.occurredAt,
+      )
+    : null;
+  if (
+    !proposal ||
+    !proposal.power ||
+    !law ||
+    law.origin !== "enacted" ||
+    law.measureId !== proposal.measureId ||
+    !policy ||
+    policy.proposalId !== proposal.id ||
+    proposal.recordedAt > outcome.occurredAt ||
+    proposal.terms.currency !== outcome.transferredAmount.currency
+  )
+    return unavailable(
+      "No exact operative typed levy/question binding for this payment.",
+    );
+  const duplicate = (world.history.statutoryTaxLiabilities ?? []).some(
+    (row) =>
+      row.sourceOutcomeId === outcome.id &&
+      row.liability !== null &&
+      (row.taxKey === proposal.terms.seriesKey ||
+        row.lawMeasureIds?.includes(proposal.measureId)),
+  );
+  if (duplicate)
+    return unavailable(
+      "This paycheck already has a saved liability for this levy; it cannot be assessed twice.",
+    );
+  const event = eventById(world, binding.sourceEventId);
+  if (
+    !event ||
+    event.occurredAt !== outcome.occurredAt ||
+    event.recordedAt > world.currentDate ||
+    event.jurisdictionId !== proposal.jurisdictionId ||
+    ![outcome.id, flow.id, work.id, work.personId].every((id) =>
+      event.involvedEntityIds.includes(id),
+    )
+  )
+    return unavailable(
+      "The canonical occurrence event does not bind this actual paycheck and worker in the levy jurisdiction.",
+    );
+  const existing = (world.history.taxBases ?? []).find(
+    (row) => row.sourceEventId === event.id,
+  );
+  if (
+    existing &&
+    (existing.payer.kind !== "person" ||
+      existing.payer.personId !== work.personId ||
+      existing.baseKey !== proposal.terms.baseKey ||
+      existing.jurisdictionId !== proposal.jurisdictionId ||
+      existing.occurredAt !== outcome.occurredAt ||
+      canonicalJson(existing.amount) !==
+        canonicalJson(outcome.transferredAmount))
+  )
+    return unavailable(
+      "The saved occurrence base differs from the actual paycheck binding.",
+    );
+  const recorded = existing
+    ? world
+    : recordTaxBase(world, {
+        stableKey: `tax-base:paycheck:${outcome.id}:${proposal.terms.baseKey}`,
+        jurisdictionId: proposal.jurisdictionId,
+        payer: { kind: "person", personId: work.personId },
+        baseKey: proposal.terms.baseKey,
+        occurredAt: outcome.occurredAt,
+        amount: outcome.transferredAmount,
+        sourceEventId: event.id,
+        assumptionNote: `Recorded payment ${outcome.id} on work flow ${flow.id}; actual transferred wages only. The admitted levy supplies the base identity; no annualization or forecast is inferred.`,
+      });
+  const base = existing ?? recorded.history.taxBases!.at(-1)!;
+  return {
+    kind: "applied",
+    world: dispatchAssessment(recorded, {
+      onDate: outcome.occurredAt,
+      activity: "assessment",
+      activityId: base.id,
+      subjectIds: [work.personId],
+      governingLawId: law.measureId,
+      questionKey: binding.questionKey,
+      origin: "enacted",
+    }),
+    baseId: base.id,
+  };
+}
+
 /** Freezes the policy effective when the taxable occurrence happened. Later
  * policy changes cannot reprice an earlier base or recollect it under a new id.
  */
