diff --git a/src/player/player.css b/src/player/player.css
index cfdc037..0608191 100644
--- a/src/player/player.css
+++ b/src/player/player.css
@@ -7699,3 +7699,59 @@
 .production-floor-layer .measure-floor {
   min-height: 100vh;
 }
+
+/* -------------------------------------------------------------------------- */
+/* One chosen person                                                           */
+/* -------------------------------------------------------------------------- */
+
+/*
+ * The surface for the person the player actually selected.
+ *
+ * It reuses the accepted quick dossier rather than introducing a second way of
+ * describing somebody, and puts the conversation for that person directly
+ * under it, so choosing a person and speaking to them are one continuous act
+ * instead of two unrelated screens.
+ */
+.life-person-surface {
+  display: grid;
+  gap: 0.9rem;
+}
+
+/*
+ * Inside this surface the dossier is content, not a floating layer: it is
+ * already inside an overlay the player opened deliberately, and a panel
+ * floating within a panel reads as two things going wrong at once.
+ */
+.life-person-surface .quick-dossier {
+  position: static;
+  width: auto;
+  max-width: none;
+  /*
+   * Let the surface grow to its content.
+   *
+   * The floating dossier is sized against the scene it hovers over — 74% of
+   * the viewport, scrolled if it overflows. Embedded in a panel that already
+   * scrolls, that cap ended the dark card early and left the last sections
+   * rendering past its background: ivory text on the panel's white paper,
+   * invisible. The height belongs to the content here, not to the viewport.
+   */
+  height: auto;
+  max-height: none;
+  overflow: visible;
+}
+
+/*
+ * One way out, not two identical ones.
+ *
+ * The panel already has a close control in its header, and this surface has an
+ * explicit "Back to people". A third × inside the dossier looked the same as
+ * the panel's and did something different, which is the worst of both.
+ */
+.life-person-surface .dossier-close {
+  display: none;
+}
+
+.life-person-actions {
+  display: grid;
+  gap: 0.6rem;
+}
diff --git a/src/presentation/player-conversation.ts b/src/presentation/player-conversation.ts
index 837c932..39a2172 100644
--- a/src/presentation/player-conversation.ts
+++ b/src/presentation/player-conversation.ts
@@ -318,3 +318,37 @@ function resolveListenerNames(
 }
 
 export { conversationSubjectPresentation };
+
+/**
+ * The conversation that can actually reach one particular person.
+ *
+ * The recorded failure this exists to prevent: the people rail emitted the id
+ * of the person the player clicked, the shell dropped it, and the generic list
+ * of every available conversation opened instead — so choosing your brother and
+ * choosing your mother produced the same screen with the same participants.
+ *
+ * Conversations are keyed by subject and room, not by person, so reaching a
+ * named person means finding the room that actually admits them as an
+ * addressee. Physical presence is checked as the fallback because a room may
+ * list somebody as present before the subject has a part for them.
+ *
+ * Returns null when no room can reach them. That is a real answer — the caller
+ * must say which limitation applies rather than opening a conversation with
+ * whoever happens to be first in the list.
+ */
+export function conversationReaching(
+  world: World,
+  playerPersonId: EntityId,
+  targetPersonId: EntityId,
+): AvailableConversation | null {
+  const available = availablePlayerConversations(world, playerPersonId);
+  return (
+    available.find((entry) =>
+      entry.room.eligibleAddresseePersonIds.includes(targetPersonId),
+    ) ??
+    available.find((entry) =>
+      entry.room.physicallyPresentPersonIds.includes(targetPersonId),
+    ) ??
+    null
+  );
+}
