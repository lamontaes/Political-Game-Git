    "source:verify-artifacts": "node --import tsx scripts/source/verify-artifacts.ts",
    "source:compile": "node --import tsx scripts/source/compile.ts",
    "source:manifest": "node --import tsx scripts/source/manifest.ts",
    "source:validate": "node --import tsx scripts/source/validate.ts",
    "source:replay": "node --import tsx scripts/source/replay.ts",
