{
  "name": "political-life-rpg",
  "version": "0.110.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/storage/cli.mjs run build -- npm run build:steps",
    "build:steps": "npm run typecheck && node scripts/clean-build.mjs && vite build && node scripts/prepare-sites-build.mjs && node scripts/stamp-client-provenance.mjs && npm run check:data-shipping -- dist test-results/data-shipping-scan.json",
    "preview": "vite preview",
    "words:composed": "node --max-old-space-size=4096 --import tsx scripts/words/composed.ts",
    "words:grade": "node --import tsx scripts/words/after-grading.ts",
    "words:pairs": "node --import tsx scripts/words/reply-pairs.ts",
    "words:review": "node --import tsx scripts/words/review.ts",
    "words:rules": "node --import tsx scripts/words/run-rules.ts",
    "words:verdicts": "node --import tsx scripts/words/fold-verdicts.ts",
    "wording:check": "node --import tsx scripts/english-check/wording.ts",
    "wording:baseline": "node --import tsx scripts/english-check/wording.ts --write",
    "compile:place-population": "node --import tsx scripts/world/compile-place-population.ts",
    "test:maps": "vitest run src/maps",
    "export:college-kinds": "node --import tsx scripts/source/export-college-kinds.ts",
    "test": "vitest run",
    "test:skill-ops": "vitest run scripts/skill-ops/skill-ops.test.ts scripts/prose-eval/grounding.test.ts scripts/prose-eval/portability.test.ts scripts/prose-eval/american-english.test.ts scripts/report-check/report-check.test.ts scripts/agent-run-receipt.test.ts scripts/agent-test-cadence.test.ts",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "node --import tsx scripts/dev-lab/typecheck.ts && node --import tsx scripts/dev-lab/typecheck-test-imports.ts && npm run check:trait-effects",
    "generate:trait-effects": "node scripts/trait-effects/generate-manifest.mjs",
    "test:trait-effects": "node --test scripts/trait-effects/generate-manifest.test.mjs",
    "test:secrets-scan": "node --test scripts/secrets/scan-tracked-secrets.test.mjs",
    "test:place-selection": "node --import tsx --test src/bench/place-selection.test.mjs",
    "check:trait-effects": "node scripts/trait-effects/generate-manifest.mjs --check",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "validate": "npm run format && npm run lint && npm run typecheck && npm run release:check && npm run zero-dice && npm run test && npm run build",
    "release:check-push": "node --import tsx scripts/release/check-push.ts",
    "release:check": "node --import tsx scripts/release/index.ts check",
    "stopgaps:report": "node scripts/stopgaps-report.mjs",
    "place-map": "node --import tsx src/core2/tooling/place-map-build.ts",
    "place-map:check": "node --import tsx src/core2/tooling/place-map-check.ts",
    "pool": "node --import tsx scripts/pool/index.ts",
    "opening:every-locality": "node --max-old-space-size=8192 --expose-gc --import tsx scripts/opening-every-locality.ts",
    "new-game-check": "node --max-old-space-size=8192 --import tsx scripts/new-game-check.ts",
    "zero-dice": "node scripts/zero-dice-guard.mjs",
    "guards": "node --import tsx scripts/guards/index.ts",
    "zero-real-data": "NODE_OPTIONS=--max-old-space-size=12288 vitest run src/core2/realistic-not-real.test.ts",
    "old-imports": "node scripts/core2-guard/old-imports.mjs",
    "all-places": "node --import tsx scripts/core2-year/all-places.mjs",
    "audit:runtime-text:score": "node --import tsx scripts/runtime-text/score.ts",
    "audit:scan": "node --import tsx scripts/audit/autoscan.ts",
    "release:preview": "node --import tsx scripts/release/index.ts preview",
    "release:apply": "node --import tsx scripts/release/index.ts apply",
    "release:recover": "node --import tsx scripts/release/index.ts recover",
    "release:declare": "node --import tsx scripts/release/index.ts declare",
    "agent:preflight": "node scripts/agent-preflight.mjs",
    "export:household-mix": "node --import tsx scripts/source/regional-money/export-household-mix.ts",
    "export:place-race-origin": "node --import tsx scripts/source/export-place-race-origin.ts",
    "storage": "node scripts/storage/cli.mjs",
    "agent:test-cadence": "node scripts/agent-test-cadence.mjs",
    "dev:identified": "node scripts/dev-identified.mjs",
    "prose:eval": "node --import tsx scripts/prose-eval/cli.ts",
    "spelling": "node --import tsx scripts/prose-eval/spelling.ts",
    "dialogue:report": "node --max-old-space-size=8192 --expose-gc --import tsx scripts/dialogue-report/report.ts",
    "scene-pictures": "node --import tsx scripts/scene-pictures/build.ts",
    "scene-web": "node --max-old-space-size=8192 --import tsx scripts/scene-web/build.ts",
    "long-game": "node --max-old-space-size=8000 --max-semi-space-size=64 --expose-gc --import tsx scripts/long-game/twenty-years.ts",
    "speed:year": "node --max-old-space-size=8192 --max-semi-space-size=64 --expose-gc --import tsx scripts/speed-years/run.ts",
    "report:check": "node scripts/report-check/cli.mjs",
    "validate:ci-sharded": "npm run format && npm run lint && npm run typecheck && npm run release:check && npm run zero-dice && npm run build",
    "secrets:scan": "node scripts/secrets/scan-tracked-secrets.mjs",
    "bench": "node scripts/storage/cli.mjs run test -- node --max-old-space-size=8192 --import tsx src/bench/server.ts",
    "check:data-shipping": "node scripts/world/check-data-shipping.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@openai/sites-vite-plugin": "0.2.0",
    "@playwright/test": "1.62.1",
    "@types/node": "22.19.19",
    "eslint": "9.39.4",
    "image-size": "^1.0.2",
    "pdfjs-dist": "^6.3.289",
    "polygon-clipping": "0.15.7",
    "prettier": "3.9.6",
    "pureimage": "^0.4.20",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "utif": "^3.1.0",
    "vite": "8.2.2",
    "vitest": "4.1.1"
  }
}
