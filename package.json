  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@openai/sites-vite-plugin": "0.2.0",
    "@playwright/test": "1.62.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "9.39.4",
    "image-size": "^1.0.2",
    "prettier": "3.9.6",
    "pureimage": "^0.4.20",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "utif": "^3.1.0",
    "vite": "8.2.2",
    "vitest": "4.1.1"
  }
}
