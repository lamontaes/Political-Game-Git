    "release:check": "node --import tsx scripts/release/index.ts check",
    "release:preview": "node --import tsx scripts/release/index.ts preview",
    "release:apply": "node --import tsx scripts/release/index.ts apply",
    "release:recover": "node --import tsx scripts/release/index.ts recover",
    "release:declare": "node --import tsx scripts/release/index.ts declare",
    "agent:preflight": "node scripts/agent-preflight.mjs",
    "dev:identified": "node scripts/dev-identified.mjs",
    "stress:persons": "node --import tsx src/cli/stress-persons.ts",
    "export:content": "node --import tsx src/cli/content-export.ts",
    "trace:export": "node --import tsx src/cli/trace-export.ts",
    "compare:seeds": "node --import tsx src/cli/compare-seeds.ts",
    "despill:edges": "node --import tsx scripts/art-asset-factory/cli-edge-despill.ts",
    "measure:references": "node --import tsx scripts/art-asset-factory/cli-measure-references.ts",
    "report:life": "node --import tsx scripts/life-report.ts",
    "prose:eval": "node --import tsx scripts/prose-eval/cli.ts",
    "corpus:prose": "node --import tsx scripts/prose-corpus/cli.ts",
    "fixture:municipal-governance": "node --import tsx scripts/source/municipal-governance-fixture.ts",
    "export:municipal-governments": "node --import tsx scripts/source/export-municipal-governments.ts",
    "check:municipal-generated": "node --import tsx scripts/source/export-municipal-governments.ts --check && node --import tsx scripts/source/export-municipal-capacity.ts --check",
    "derive:people-visual4": "node --import tsx scripts/art-asset-factory/people-visual4.ts"
