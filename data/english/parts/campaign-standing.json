{
  "schema": "english-parts/1",
  "register": "campaign-standing",
  "description": "How the Campaigns screen says where a race stands: voters reached, how many warmed or cooled, who the opponents are, the last poll and what a poll costs. Every part is a whole sentence; the facts are slots from the campaign's cause, filing and poll records and the Poll action's price. The volunteer asks say each answer: yes (the person signs on) or no (they cannot help just now), from the volunteer ask's answer.",
  "slots": {
    "reached": "Voters reached, from the campaign's cause records (each voter once).",
    "warmer": "Voters whose warmth toward the candidate rose, from the same records.",
    "cooler": "Voters whose warmth fell, from the same records.",
    "opponents": "The other candidates on the contest's filing records.",
    "name": "One candidate on the contest's filing records.",
    "sample": "The poll's sample size, from the Poll action.",
    "cost": "Dollars the poll costs: sample times the campaign engine's price per interview.",
    "date": "The date the poll was taken.",
    "contacted": "Voters who answered the poll.",
    "tally": "Each answer with its count, from the poll record.",
    "amount": "Dollars given, from the gift row and journal entry.",
    "gave": "How many people gave on this call.",
    "asked": "How many people were asked on this call.",
    "office": "The seat as people say it (\"a seat on the Mutual Village Council\", \"mayor\"), from the contest and office records through the one seat reader.",
    "closes": "The day filing closes, while it is still ahead, from the contest's filing deadline.",
    "raised": "Dollars the campaign has raised in all, from the campaign record.",
    "cash": "Dollars the campaign holds now (raised less spent), from the campaign record.",
    "filed": "The day the player filed, as people say a date, from the filing record.",
    "general": "The general election's day, as people say a date, from the contest record, once the primary is past or where there is none.",
    "primary": "The primary's day, as people say a date, from the contest record, while it is ahead."
  },
