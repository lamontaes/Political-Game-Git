{
  "schema": "english-parts/1",
  "register": "election-day",
  "description": "The narrator on election day and night: the morning, the canvass, the choice to vote, the returns as each place reports, and the call. Authored to the pattern of local election-night coverage (docs/research/words-scenes-2026-10-26.md, part 2): returns arrive place by place, the first numbers carry uncertainty, and the call comes when every place is in.",
  "slots": {
    "all": "How many places report in all.",
    "cast": "Ballots cast, from the count.",
    "companion": "A household member, by name.",
    "count": "A count from the record.",
    "in": "How many places have reported.",
    "lead": "The leader's votes there.",
    "leader": "The candidate ahead, by name.",
    "margin": "The lead in votes, from the count.",
    "name": "A person, by name, from the records.",
    "number": "A count from the record.",
    "office": "The office, from the contest record.",
    "opponent": "The other candidate, from the contest record.",
    "place": "The town, from the place records.",
    "reached": "How many talked with you, from the canvass record.",
    "trail": "The runner-up's votes there.",
    "where": "A place that reported, from the count.",
    "winner": "The winner, by name."
  },
  "maxWords": 16,
