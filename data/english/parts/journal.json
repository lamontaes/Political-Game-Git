      "crec": 445,
      "hearings": 1617,
      "house": 115,
      "nasa": 317,
      "wpa": 38
    },
    "rule": "A shape is kept when at least 2 documents say it as a whole sentence and one of them is a public-domain record from 2015 or later, which is its source.",
    "notAttested": 101
  },
