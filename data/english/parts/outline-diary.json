{
  "schema": "english-parts/1",
  "register": "outline-diary",
  "description": "The Journal's first evening (watched, stance, said, mine, ahead), written by the diary writer under the Story lead's spec (docs/story/writer-spec.md).",
  "slots": {
    "term-left": "the time left in the speaker's term, in words (\"four years\"), from the term's record",
    "theme-name": "the speech's theme said as people say it (speech-outlines.json themeNames), from the planner's theme",
    "theme-short": "the theme said short (speech-outlines.json themeShort)",
    "run-span": "how long the economy's run lasted, in words, from the macro months (address-story.ts)",
    "the-disaster": "the year's worst declared disaster as people say it after 'the' (outlines.json disasterWords), from the national events engine's row",
    "about": "the policy question's spoken noun phrase (question-names.json)",
    "to": "what the question would do, as a verb phrase (question-names.json to)",
    "law-name": "the law in force or proposed, named (question-names.json law)",
    "other-side": "what the other side of the speaker's stand wants done, as a verb phrase",
    "belief": "the speaker's reason on the question, as a clause (question-names.json reasons)",
    "belief-sentence": "the same reason as its own sentence",
    "today": "how the question stands today, said from the speaker's side, as a sentence",
    "today-clause": "the same, as a clause that ends the sentence",
    "the-vice-president": "the Vice President by office and name, from the officials engine's seat",
    "president": "the President, said by the said-as reader (role first, then pronoun)",
    "president-object": "the President in the object case",
    "said": "the question in plain words, as people say it (question-names.json said)",
    "decider": "who decides it (Congress), from said-as",
    "place": "the speaker's town",
    "employer": "the speaker's employer, through the said-as reader",
    "born-year": "the year the player was born, from the birth record",
    "school-year": "the year the player first started school",
    "school-place": "the town the player first went to school in",
    "moved-year": "the year the player's household moved",
    "moved-from": "the town they moved from",
    "moved-to": "the town they moved to",
    "finished-year": "the year the player finished high school",
    "college-year": "the year the player started college",
    "lost-office": "the office the player ran for and lost, as people say it",
    "lost-year": "the year of that race",
    "lost-votes": "the player's votes in it, as a number",
    "winner-votes": "the winner's votes in it",
    "start-month": "the month the game opens",
    "start-year": "the year the game opens",
    "state": "the player's state, as a sentence says it",
    "president-name": "the President's full name, from the officials engine",
    "we": "the household members who watched and the player, as the subject of a sentence (\"Joe, Ann and I\")",
    "us": "the same, as its object (\"Joe, Ann and me\")",
    "name": "the person's full name, from the record",
    "surname": "the person's family name, from the record",
    "date": "the day as a news story says it",
    "quote": "the line of the address a reader can quote, from the address's record",
    "body": "the body that voted, as its record names it",
    "law": "the bill or law by its name, never its number",
    "purpose": "what the bill does, as a noun phrase from the bill catalog",
    "count": "the vote count in words and figures (\"3 to 2\")",
    "reason-for": "the reason people give for the question, as a clause (question-names.json reasons.for)",
    "reason-against": "the reason people give against it, as a clause (question-names.json reasons.against)",
    "housemate-worker": "a housemate's given name, from the job record",
    "housemate-employer": "that housemate's employer as people say it, from the employer record",
    "kin-wrote": "a relative's given name, from a family.contact letter in the past month",
    "kin-wrote-from": "the town that relative wrote from"
  },
  "maxWords": 30,
