{
  "schema": "english-parts/1",
  "register": "legislation",
  "description": "Sourced legislation-wording parts: the enacting clause, short and long titles, generic section headings and drafting clauses, mined from bills of the 119th Congress (public domain). Each text is a recurring drafting shape with its particulars replaced by slots; billsUsing counts how many of the 150 bills read use it.",
  "slots": {
    "act": "The full short title of an act, in quotation marks.",
    "shortAct": "A second, shorter popular name for the same act.",
    "purpose": "What the bill does, in a verb phrase.",
    "requirement": "What the bill requires and of whom.",
    "program": "The program, office or rule the bill creates or improves.",
    "conduct": "The conduct the bill bans.",
    "official": "The official or agency head given the duty.",
    "duty": "The duty, in a verb phrase.",
    "action": "What the bill authorizes.",
    "provision": "The section of law being changed, such as section 12 of an act.",
    "address": "The street address of a post office.",
    "name": "The name given to the facility.",
    "scope": "section or Act.",
    "period": "A length of time, such as 180 days.",
    "oldText": "The words removed.",
    "newText": "The words added.",
    "anchor": "The words the new text follows.",
    "committees": "The committees that receive the report.",
    "subject": "What the report or rule covers.",
    "amount": "A dollar amount or such sums as may be necessary.",
    "limit": "What the law is not read to do.",
    "view": "The view Congress states."
  },
  "maxWords": 20,
