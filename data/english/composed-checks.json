{
  "schema": "english-composed-checks/1",
  "about": "What the composed checks (src/english/composed-checks.ts) read whole texts with: the numbers, each TUNABLE with the spread it is checked against, and the word lists, each from the owner's notes of Nov 11 and 12, 2026 or the words skill. Development-time only: no list here picks a line in play.",
  "parameters": {
    "seriesMostParts": {
      "value": 3,
      "tag": "TUNABLE",
      "spread": "3 to 4",
      "note": "A sentence cut by more commas than this into parts is a series or a list of names (\"Chief Justice, honored guests, everybody, ...\"), and the splice check leaves it alone."
    },
    "subjectBudget": {
      "value": 3,
      "tag": "TUNABLE",
      "spread": "2 to 4",
      "note": "The most times one subject's word may be said in one speech (words skill, Nov 11: a subject's word at most three times in one speech or scene)."
    },
    "subjectWordLeastLetters": {
      "value": 4,
      "tag": "TUNABLE",
      "spread": "3 to 5",
      "note": "A word shorter than this is not counted as a subject."
    },
    "askOverlap": {
      "value": 0.6,
      "tag": "TUNABLE",
      "spread": "0.5 to 0.8",
      "note": "Two asks in one speech are the same ask when this share of the shorter one's subject words are in the other."
    },
    "askLeastWords": {
      "value": 3,
      "tag": "TUNABLE",
      "spread": "2 to 4",
      "note": "An ask with fewer subject words than this is not compared."
    },
    "loopDays": {
      "value": 3,
      "tag": "TUNABLE",
      "spread": "3 to 4",
      "note": "The same opener to the same person on this many days in one window is a daily loop (owner, Nov 12: the 7:00 a.m. work talk every morning)."
    },
    "loopWindowDays": {
      "value": 7,
      "tag": "TUNABLE",
      "spread": "7 to 7",
      "note": "The window a daily loop is counted in: a week."
    },
    "ackMostWords": {
      "value": 3,
      "tag": "TUNABLE",
      "spread": "2 to 3",
      "note": "An answer this short that only acknowledges is a non-reply (owner, Nov 12; replies of one to three words stay for the player, call 12)."
    },
    "echoLeastWords": {
      "value": 4,
      "tag": "TUNABLE",
      "spread": "3 to 6",
      "note": "A sentence this long said by two speakers of one household on one day is an echo; shorter ones (a greeting) are not."
    },
    "morningEndsMinute": {
      "value": 720,
      "tag": "TUNABLE",
      "spread": "660 to 720",
      "note": "Noon: past it, a line looking ahead to this morning is over."
    },
    "eveningStartsMinute": {
      "value": 1020,
      "tag": "TUNABLE",
      "spread": "960 to 1080",
      "note": "5 p.m.: past it, a line looking ahead to this afternoon is over."
    },
    "nightStartsMinute": {
      "value": 1200,
      "tag": "TUNABLE",
      "spread": "1140 to 1260",
      "note": "8 p.m.: past it, \"pick this up again tonight\" looks ahead to a night already here (owner, Nov 12, said at 8:30 p.m.)."
    },
    "morningLastMinute": {
      "value": 660,
      "tag": "TUNABLE",
      "spread": "600 to 720",
      "note": "Before 11 a.m., talk of a day already done is end-of-day talk in the morning (owner, Nov 12: \"Busy one at work today?\" at 7:00 a.m.)."
    }
  },
  "placeSaidOnlyAs": {
    "note": "A place whose bare name means something else in a speech, with the spelling that means the place. Alone, the first is the federal capital, so the stray-place check counts only the spelling given here.",
