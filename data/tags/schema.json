      "kind": "object",
      "fields": {
        "usps": "two-letter state, D.C. or territory code",
        "countyFips": "five-digit county code",
        "cityId": "the world's jurisdiction id for a town"
      }
    },
    "level": [
      "federal",
      "state",
      "county",
      "city",
      "school",
      "party",
      "private"
    ],
