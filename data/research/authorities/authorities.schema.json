{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Policy-topic authority research batch",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "area",
    "baseline",
    "researchedAt",
    "status",
    "places",
    "sources",
    "topics",
    "verification",
    "remainingWork"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "area": {
      "type": "string",
      "minLength": 1
    },
    "baseline": {
      "type": "string",
      "minLength": 1
    },
    "researchedAt": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": ["research draft", "ready for CTO review"]
    },
    "places": {
      "type": "array",
      "minItems": 56,
      "maxItems": 56,
      "uniqueItems": true,
      "items": {
        "enum": [
          "AL",
          "AK",
          "AZ",
          "AR",
          "CA",
          "CO",
          "CT",
          "DE",
          "FL",
          "GA",
          "HI",
          "ID",
          "IL",
          "IN",
          "IA",
          "KS",
          "KY",
          "LA",
          "ME",
          "MD",
          "MA",
          "MI",
          "MN",
          "MS",
          "MO",
          "MT",
          "NE",
          "NV",
          "NH",
          "NJ",
          "NM",
          "NY",
          "NC",
          "ND",
          "OH",
          "OK",
          "OR",
          "PA",
          "RI",
          "SC",
          "SD",
          "TN",
          "TX",
          "UT",
          "VT",
          "VA",
          "WA",
          "WV",
          "WI",
          "WY",
          "DC",
          "PR",
          "GU",
          "VI",
          "AS",
          "MP"
        ]
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "url", "year", "accessed", "kind"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "pattern": "^https://"
          },
          "year": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1800,
                "maximum": 2026
              },
              {
                "type": "null"
              }
            ],
            "description": "Publication or codification year when established; null for an undated source. Accessed is recorded separately."
          },
          "accessed": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "primary",
              "accepted-survey",
              "study",
              "government-evaluation"
            ]
          }
        }
      }
    },
    "topics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "topicKey",
          "catalogLevels",
          "dialIds",
          "proposedDials",
          "authorities",
          "interactions",
          "decisions",
          "federalLink",
          "systemRedesigns",
          "gameToday",
          "remainingWork"
        ],
        "properties": {
          "topicKey": {
            "type": "string",
            "minLength": 1
          },
          "catalogLevels": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "dialIds": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "proposedDials": {
            "type": "array",
            "minItems": 0,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "authorities": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "level",
                "body",
                "does",
                "legalSource",
                "sources",
                "organizationRequirement"
              ],
              "properties": {
                "level": {
                  "enum": [
                    "federal",
                    "state",
                    "dc",
                    "territory",
                    "county",
                    "city",
                    "school-district",
                    "special-district",
                    "tribal"
                  ]
                },
                "body": {
                  "type": "string",
                  "minLength": 1
                },
                "does": {
                  "type": "string",
                  "minLength": 1
                },
                "legalSource": {
                  "type": "string",
                  "minLength": 1
                },
                "sources": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "organizationRequirement": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "interactions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["chain", "pattern", "settings", "sources"],
              "properties": {
                "chain": {
                  "type": "array",
                  "minItems": 2,
                  "items": {
                    "enum": [
                      "federal",
                      "state",
                      "dc",
                      "territory",
                      "county",
                      "city",
                      "school-district",
                      "special-district",
                      "tribal"
                    ]
                  }
                },
                "pattern": {
                  "enum": [
                    "federal floor",
                    "field preemption",
                    "conditional spending",
                    "cooperative administration",
                    "state preemption of local action",
                    "delegation or enabling",
                    "local administration of a state duty",
                    "concurrent",
                    "compact or authority"
                  ]
                },
                "settings": {
                  "type": "array",
                  "minItems": 0,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "sources": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          },
          "decisions": {
            "type": "array",
            "minItems": 0,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "question",
                "levels",
                "terms",
                "examples",
                "availability",
                "effects",
                "directMechanism",
                "startingLaw"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "question": {
                  "type": "string",
                  "minLength": 1
                },
                "levels": {
                  "type": "array",
