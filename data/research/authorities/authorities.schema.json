                    "properties": {
                      "place": {
                        "type": "string",
                        "minLength": 1
                      },
                      "measure": {
                        "type": "string",
                        "minLength": 1
                      },
                      "year": {
                        "type": "integer",
                        "minimum": 2010,
                        "maximum": 2026
                      },
                      "status": {
                        "enum": [
                          "enacted",
                          "passed chamber",
                          "went to voters",
                          "agency decision"
                        ]
                      },
                      "sources": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    }
                  }
                },
                "availability": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "status",
                      "scope",
                      "reason",
                      "sources",
                      "bars",
                      "localGrant",
                      "differentLargeCityCharters"
