{
  "version": 1,
  "note": "Developer data for the story director (docs/design/story-director.md, part 1). Never shown to a player. A record scores for each person it names; it reaches relatives only through a row that names that relation.",
  "sources": {
    "srrs-adult": {
      "citation": "Holmes, T. H., and Rahe, R. H. (1967). The Social Readjustment Rating Scale. Journal of Psychosomatic Research, 11(2), 213-218.",
      "status": "estimatedFrom"
    },
    "srrs-non-adult": {
      "citation": "Holmes and Rahe Stress Scale, non-adult version, as published with the adult scale (attributed to Zenko and Marn, 2014). Weaker sourcing than the adult scale.",
      "status": "estimatedFrom"
    },
    "relationship-standing": {
      "citation": "The relationship standing reader's significance and change weights (src/simulation/relationship-standing.ts), capped at the adult scale's row 'More frequent disputes' (35). Approved by the owner, October 8, 2026.",
      "status": "calibration"
    }
  },
  "calibration": {
    "firstOfKind": 1.5,
    "traitTiltAtFullStrength": 0.25,
    "closenessRange": [0.5, 1.5],
    "relationshipCap": 0.35,
    "stakesAtFullYear": 0.5,
    "relationshipSignificance": {
      "minor": 0,
      "meaningful": 2,
      "major": 3
    },
    "relationshipChange": {
      "formed": 2,
      "strengthened": 2,
      "maintained": 1,
      "strained": 2,
      "ended": 3
    }
  },
