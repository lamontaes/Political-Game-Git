.agent-receipts/

# Storm Events publisher bytes: 243 MB of NCEI .gz files kept outside the
# repository. artifact-lock.json pins every file by sha256; the compiler reads
# them with --raw-dir.
data/source/storm-events-2000-2024/raw/
