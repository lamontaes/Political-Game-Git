{
  "header": "The rules of the check-changes guard (scripts/guards/check-changes.mjs): what a pull request may not add to the checks that judge it. The guard reads this file from main, never from the pull request. A change it refuses needs a line on the crew issue, written by the CTO, that starts with the approval words and names the pull request by number.",
  "crewIssue": 9747,
  "testFiles": "(\\.test\\.[cm]?[jt]sx?$|\\.node-test\\.[cm]?[jt]s$)",
  "counts": [
    {
      "id": "expected-failure",
      "says": "an expected-failure, skip, only or todo mark",
      "files": "(\\.test\\.[cm]?[jt]sx?$|\\.node-test\\.[cm]?[jt]s$)",
      "pattern": "\\b(?:it|test|describe|bench|suite)(?:\\.concurrent|\\.sequential)?\\.(?:fails|skip|only|todo|skipIf|runIf)\\b|\\bx(?:it|describe|test)\\s*\\("
    },
    {
      "id": "known-red-row",
      "says": "a known-red row",
      "files": "\\.(?:json|[cm]?[jt]sx?)$",
      "pattern": "[\"']?knownRed[\"']?\\s*:\\s*[\"']"
    },
    {
      "id": "failing-today-row",
      "says": "a row in the played year's failing-today list",
      "files": "played-world\\.node-test\\.ts$",
      "pattern": "\\bowner:\\s*[\"']"
    },
    {
      "id": "pinned-place-or-seed",
      "says": "a test pinned to a named town or seed",
      "files": "(\\.test\\.[cm]?[jt]sx?$|\\.node-test\\.[cm]?[jt]s$)",
      "pattern": "\\bplaceKey:\\s*[\"'`]|[\"'`][0-9a-f]{64}[\"'`]|\\bkey:\\s*[\"'`](?:\\d{7}|territory:[A-Z]{2}:[a-z0-9-]+)[\"'`]|GOLDEN_PATH_(?:SEED|PLACE_KEY)\\s*=(?!=)"
    },
    {
      "id": "drawn-seed-dropped",
      "says": "a drawn seed (randomBytes or a seed read from the environment), which pins the test",
      "files": "(\\.test\\.[cm]?[jt]sx?$|\\.node-test\\.[cm]?[jt]s$)",
      "pattern": "\\brandomBytes\\s*\\(|\\bprocess\\.env\\.[A-Z_]*SEED\\b",
      "refuse": "fewer"
    }
  ],
  "baselines": "(^|/)[^/]*(?:baseline|ceiling)[^/]*\\.json$",
  "baselineRoots": "^(tests/|scripts/|data/runtime-text/)",
  "ownFiles": [
    "scripts/guards/check-changes.mjs",
    "tests/guards/check-changes.json",
    ".github/workflows/checks-guard.yml"
  ],
  "pinOnlyCase": "pinned place|fixed seed|pinned seed",
  "pinOnlyRuling": "The CTO's standing ruling on issue 9747: when a test moves from a pinned place or seed to a drawn one, it may delete the case that only checked the pin (a case whose title names its pinned place or fixed seed).",
  "approvalStart": "^CTO:",
  "approvalLine": "#{number}\\b[^.;]*\\bapprov|\\bapprov\\w*\\b[^.;]*#{number}\\b",
  "approvalRefused": "\\bnot\\b[^.]*\\bapprov|\\bunapprov",
  "skillFiles": "^\\.agents/skills/[^/]+/SKILL\\.md$",
  "guardTests": "^tests/guards/[^/]+\\.test\\.ts$",
  "guardList": "scripts/guards/index.ts"
}
