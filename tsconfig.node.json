{
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2023",
    "lib": [
      "ES2023",
      "DOM"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "playwright.config.ts",
    "scripts/source/**/*.ts",
    "src/cli/**/*.ts",
    "src/persistence/**/*.ts",
    "src/simulation/**/*.ts",
    "src/source/**/*.ts",
    "tests/e2e/**/*.ts",
    "tests/source/**/*.ts",
    "vite.config.ts"
  ]
}
