{
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "types": ["node", "vite/client"]
  },
  "include": [
    "playwright.config.ts",
    "scripts/source/**/*.ts",
    "src/cli/**/*.ts",
    "src/content/**/*.ts",
    "src/devtools/**/*.ts",
    "src/environment/**/*.ts",
    "src/persistence/**/*.ts",
    "src/presentation/**/*.ts",
    "src/simulation/**/*.ts",
    "src/source/**/*.ts",
    "tests/e2e/**/*.ts",
    "tests/source/**/*.ts",
    "vite.config.ts"
  ],
  "exclude": ["src/presentation/**/*.test.ts"]
}
