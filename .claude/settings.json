{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/report-check/hook.mjs\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__Google_Drive__create_file",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/report-check/hook.mjs\""
          }
        ]
      }
    ]
  }
}
