{
  "permissions": {
    "allow": [
      "Bash(git merge origin/main)",
      "Edit(/.github/workflows/release.yml)",
      "WebFetch",
      "Bash(gh pr merge:*)",
      "Bash(gh api -X PUT repos/lamontaes/Political-Game-Git/pulls/:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/report-check/hook.mjs\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/claude-cloud-permissions.mjs\""
          }
        ]
      },
      {
        "matcher": "mcp__Google_Drive__create_file",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/report-check/hook.mjs\""
          }
        ]
      }
    ]
  }
}
