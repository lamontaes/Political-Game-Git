          "organization_a37d0a070eae8fd1",
          "past-work:person_00e7e32c91f867ef:3",
          "organization_9c23d9190ca580d7"
        ],
        "date": "2002-12-14",
        "text": "Seven years on, after Nguyen Manufacturing, I took a job at Santiago Building Services. I had worked at Nguyen Manufacturing for seven years. It paid about $25 an hour."
      },
      {
        "person": "person_00e7e32c91f867ef",
        "kinds": ["job-ended:moved-on"],
        "recordIds": [
          "past-work:person_00e7e32c91f867ef:2",
