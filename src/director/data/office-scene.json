{
  "version": "office-scene-v1",
  "description": "The office scene's structure (owner, Oct 14, 2026: scenes carry the consequential dialogue): a floor vote where the goal is one member's vote. Which mined parts each moment and choice says, by part key; the sentences live in data/english/parts. No sentence is written here.",
  "goal": {
    "kind": "member-vote",
    "reads": "The target's recorded vote on the bill (the legislature's votes table), which the target's position decides."
  },
  "narration": {
    "setting": {
      "bank": "scene-words",
      "keys": [
        "scene-words.setting-public-out.youre-in-place",
        "scene-words.setting-public-out.you-are-in-place"
      ]
    },
    "present": {
      "bank": "scene-words",
      "keys": [
        "scene-words.present-one-one.who-is-here",
        "scene-words.present-one-one.who-is-there"
      ]
    },
    "lead": {
      "bank": "scene-words",
      "keys": [
        "scene-words.lead-office-scene-any.name-is-the-member-you-need-to-reach",
        "scene-words.lead-office-scene-any.this-bill-is-about-issue-and-name-is-the-one-to-"
      ]
    }
  },
  "choices": [
    {
      "key": "make-case",
      "records": "case",
      "label": {
        "bank": "choice-names",
        "keys": ["choice-names.take-up-cause.speak-up"]
      },
      "line": {
        "bank": "address",
        "keysBySide": {
          "yes": ["address.campaign-ask.i-need-your-vote"],
          "no": ["address.campaign-ask.i-need-your-vote"]
        }
      }
    },
    {
      "key": "appeal",
      "records": "appeal",
      "label": {
        "bank": "choice-names",
        "keys": [
          "choice-names.contact-known-person.talk-to-name",
          "choice-names.contact-known-person.go-see-name"
        ]
      },
      "line": {
        "bank": "address",
        "keysBySide": {
          "yes": ["address.member-ask.can-i-count-on-you"],
          "no": ["address.member-ask.can-i-count-on-you"]
        }
      }
    },
    {
      "key": "silent",
      "records": "nothing",
      "label": {
        "bank": "choice-names",
        "keys": [
          "choice-names.carry-on.keep-your-head-down",
          "choice-names.carry-on.let-it-go",
          "choice-names.carry-on.stay-the-course"
        ]
      }
    }
  ],
  "reply": {
    "bank": "choice-names",
    "keysByLean": {
      "for": [
        "choice-names.stance-answer.i-support-it",
        "choice-names.stance-answer.im-in-favor-of-it"
      ],
      "against": [
        "choice-names.stance-answer.i-oppose-it",
        "choice-names.stance-answer.im-against-it"
      ],
      "even": ["choice-names.stance-answer.i-havent-decided"]
    }
  },
  "parameters": {
    "appealClosenessWeight": {
      "value": 2,
      "tag": "TUNABLE",
      "citation": "How far a personal appeal carries per unit of the two people's closeness today, against a face-to-face case on the merits (the speech engine's speechImpulse, which the appeal is multiplied from): close ties move political views more than acquaintances do (Huckfeldt and Sprague 1995, Citizens, Politics and Social Communication). No study sets the size; at 2 an appeal to someone at half closeness weighs as much as the case. Spread 1 to 3."
    },
    "hearingTightMargin": {
      "value": 1,
      "tag": "TUNABLE",
      "citation": "How narrow a committee vote must be (yes minus no, in votes) for the chair to press the witness for a plain yes or no rather than a follow-up. Not studied; a one-vote margin is the closest a vote can be without tying (a tie is margin 0). Spread 0 to 2."
    }
  },
  "hearing": {
    "bank": "hearing",
    "questionKeys": [
      "hearing.question.what-would-this-bill-change-for-you",
      "hearing.question.how-would-this-bill-affect-the-people-you-speak-for",
      "hearing.question.what-does-the-committee-need-to-know-before-it-votes",
      "hearing.question.who-does-this-bill-help-and-who-does-it-hurt",
      "hearing.question.can-you-give-us-an-example",
      "hearing.question.could-you-elaborate-on-that"
    ],
    "replyKeys": [
      "hearing.answer.thank-you-for-the-question",
      "hearing.answer.thank-you-for-that-question",
      "hearing.answer.thank-you-for-your-question",
      "hearing.answer.that-is-a-great-question"
    ],
    "pressKeys": ["hearing.question.yes-or-no"],
    "followUpKeys": [
      "hearing.question.is-that-right",
      "hearing.question.is-that-fair-to-say",
      "hearing.question.why",
      "hearing.question.correct",
      "hearing.question.is-that-correct",
      "hearing.question.would-you-agree-with-that",
      "hearing.question.is-that-true",
      "hearing.question.why-not",
      "hearing.question.what-does-that-mean",
      "hearing.question.is-that-fair"
    ]
  }
