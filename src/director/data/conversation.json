{
  "version": "p15-conversation-v2",
  "stopgapId": "SG-P15-conversation-banks",
  "about": "Conversation words on the new core. Each subject is a record the speaker holds; each template copies only recorded facts. The other person asks or tells; every choice answers that line (rule R3) with a different move: plainly, with a further fact from the records, by turning the question back, or briefly before raising something else. The lie line exists only for a question about the player's own record that the listener does not already know.",
  "minimumChoices": 4,
  "toldEvent": "conversation.told",
  "lieEvent": "conversation.lie",
  "minutesPerExchange": 2,
  "replyKinds": {
    "own-work": "heard-work",
    "their-work": "other-work",
    "home": "home-reply",
    "their-tenure": "tenure-reply"
  },
  "subjects": {
    "own-work": {
      "ask": [
        {
          "key": "still-at",
          "text": "Still at {{employer}}?"
        }
      ],
      "raise": [
        {
          "key": "tell",
          "text": "I'm still at {{employer}}."
        }
      ],
      "answers": [
        {
          "key": "plain",
          "text": "Yes, still at {{employer}}."
        },
        {
          "key": "since",
          "text": "Yes. I've been there since {{since}}."
        },
        {
          "key": "turn",
          "text": "Still there. And you?",
          "raises": "their-work"
        },
        {
          "key": "brief",
          "text": "Same as ever.",
          "raises": "next"
        }
      ],
      "lie": [
        {
          "key": "left",
          "text": "No, I'm not at {{employer}} anymore.",
          "stages": ["none"]
        },
        {
          "key": "elsewhere",
          "text": "No, I'm at {{claimed}} now.",
          "stages": ["elsewhere"]
        }
      ]
    },
    "home": {
      "ask": [
        {
          "key": "still-in",
          "text": "Are you still living in {{place}}?"
        }
      ],
      "raise": [
        {
          "key": "still-in",
          "text": "Are you still in {{place}}?"
        }
      ],
      "answers": [
        {
          "key": "plain",
          "text": "Yes, still in {{place}}."
        },
        {
          "key": "years",
          "text": "Yes, {{years}} years now.",
          "stages": ["moved"]
        },
        {
          "key": "always",
          "text": "All my life.",
          "stages": ["born"]
        },
        {
          "key": "turn",
          "text": "I am. You too?",
          "raises": "home"
        },
        {
          "key": "brief",
          "text": "Still here.",
          "raises": "next"
        }
      ],
      "lie": [
        {
          "key": "moved",
          "text": "No, I moved away from {{place}}.",
          "stages": ["none"]
        },
        {
          "key": "elsewhere",
          "text": "No, I live in {{claimed}} now.",
          "stages": ["elsewhere"]
        }
      ]
    },
    "shared-school": {
      "ask": [
        {
          "key": "remember",
          "text": "Do you remember {{school}}?"
        }
      ],
      "raise": [
        {
          "key": "remember",
          "text": "Do you remember {{school}}?"
        }
      ],
      "reply": [
        {
          "key": "years",
          "text": "{{school}}. That was {{years}} years ago."
        }
      ],
      "answers": [
        {
          "key": "plain",
          "text": "{{school}}, yes."
        },
        {
          "key": "years",
          "text": "Of course. That was {{years}} years ago."
        },
        {
          "key": "turn",
          "text": "I do.",
          "raises": "mutual"
        },
        {
          "key": "brief",
          "text": "Sure.",
          "raises": "next"
        }
      ]
    },
    "shared-work": {
      "ask": [
        {
          "key": "remember",
          "text": "Remember working at {{employer}}?"
        }
      ],
      "raise": [
        {
          "key": "still",
          "text": "Are you still at {{employer}}?"
        }
      ],
      "reply": [
        {
          "key": "still",
          "text": "I'm still at {{employer}}.",
          "stages": ["still"]
        },
        {
          "key": "left",
          "text": "I left {{employer}}.",
          "stages": ["left"]
        }
      ],
      "answers": [
        {
          "key": "plain",
          "text": "{{employer}}, right."
        },
        {
          "key": "turn",
          "text": "{{employer}}, sure.",
          "raises": "their-work"
        },
        {
          "key": "brief",
          "text": "Right.",
          "raises": "next"
        },
        {
          "key": "own",
          "text": "I'm still at {{my-employer}}.",
          "requiresFacts": ["my-employer"]
        }
      ]
    },
    "their-work": {
      "raise": [
        {
          "key": "ask",
          "text": "Are you still working?"
        }
      ]
    },
    "other-work": {
      "reply": [
        {
          "key": "at",
          "text": "I'm at {{employer}}.",
          "stages": ["working"]
        },
        {
          "key": "none",
          "text": "Not right now.",
          "stages": ["none"]
        }
      ],
      "answers": [
        {
          "key": "ack",
          "text": "{{employer}}, right.",
          "stages": ["working"]
        },
        {
          "key": "ack-none",
          "text": "I see.",
          "stages": ["none"]
        },
        {
          "key": "tenure",
          "text": "How long have you been there?",
          "stages": ["working"],
          "raises": "their-tenure"
        },
        {
          "key": "own",
          "text": "I'm still at {{my-employer}}."
        },
        {
          "key": "brief",
          "text": "Right.",
          "raises": "next"
        }
      ]
    },
    "their-tenure": {
      "raise": [
        {
          "key": "ask",
          "text": "How long have you been there?"
        }
      ]
    },
    "tenure-reply": {
      "reply": [
        {
          "key": "since",
          "text": "Since {{since}}."
        }
      ],
      "answers": [
        {
          "key": "ack",
          "text": "Since {{since}}, right."
        },
        {
          "key": "own",
          "text": "I've been at {{my-employer}} since {{my-since}}."
        },
        {
          "key": "brief",
          "text": "Right.",
          "raises": "next"
        },
        {
          "key": "turn",
          "text": "That's a while.",
          "raises": "next-2"
        }
      ]
    },
    "heard-work": {
      "reply": [
        {
          "key": "ok",
          "text": "{{employer}}, right."
        }
      ],
      "answers": [
        {
          "key": "yes",
          "text": "Yes."
        },
        {
          "key": "since",
          "text": "Since {{since}}."
        },
        {
          "key": "turn",
          "text": "Yes. And you?",
          "raises": "their-work"
        },
        {
          "key": "brief",
          "text": "That's right.",
          "raises": "next"
        }
      ]
    },
    "home-reply": {
      "reply": [
        {
          "key": "still",
          "text": "I'm still in {{place}}."
        }
      ],
      "answers": [
        {
          "key": "same",
          "text": "Same here.",
          "stages": ["same"]
        },
        {
          "key": "ack",
          "text": "{{place}}, right."
        },
        {
          "key": "own",
          "text": "I'm still in {{my-place}}."
        },
        {
          "key": "brief",
          "text": "Right.",
          "raises": "next"
        }
      ]
    },
    "mutual": {
      "raise": [
        {
          "key": "seen",
          "text": "Have you seen {{name}}?"
        }
      ],
      "reply": [
        {
          "key": "saw",
          "text": "I saw {{name}} on {{when}}.",
          "stages": ["saw"]
        },
        {
          "key": "not",
          "text": "I haven't seen {{name}} lately.",
          "stages": ["not"]
        }
      ],
      "answers": [
        {
          "key": "ack",
          "text": "{{name}}, right."
        },
        {
          "key": "mine-saw",
          "text": "I saw {{name}} on {{my-when}}.",
          "requiresFacts": ["my-when"]
        },
        {
          "key": "mine-not",
          "text": "I haven't seen {{name}} in a while either.",
          "stages": ["not"],
          "requiresFacts": ["my-not"]
        },
        {
          "key": "brief",
          "text": "Okay.",
          "raises": "next"
        },
        {
          "key": "turn",
          "text": "Right.",
          "raises": "next-2"
        }
      ]
    },
    "kin": {
      "raise": [
        {
          "key": "met",
          "text": "Have you met {{relation}}, {{name}}?"
        }
      ],
      "reply": [
        {
          "key": "not",
          "text": "No, I haven't met {{name}}."
        }
      ],
      "answers": [
        {
          "key": "is",
          "text": "{{name}} is {{relation}}."
        },
        {
          "key": "lives",
          "text": "{{name}} lives with me.",
          "requiresFacts": ["housemate"]
        },
        {
          "key": "brief",
          "text": "You will.",
          "raises": "next"
        },
        {
          "key": "turn",
          "text": "Maybe one day.",
          "raises": "next-2"
        }
      ]
    },
    "own-work-new": {
      "ask": [
        {
          "key": "where",
          "text": "Where are you working these days?"
        }
      ],
      "answers": [
        {
          "key": "plain",
          "text": "At {{employer}}."
        },
        {
          "key": "since",
          "text": "At {{employer}}, since {{since}}."
        },
        {
          "key": "turn",
          "text": "At {{employer}}. And you?",
          "raises": "their-work"
        },
        {
          "key": "brief",
          "text": "{{employer}}.",
          "raises": "next"
        }
      ],
      "lie": [
        {
          "key": "none",
          "text": "I'm not working right now.",
          "stages": ["none"]
        },
        {
          "key": "elsewhere",
          "text": "At {{claimed}}.",
          "stages": ["elsewhere"]
        }
      ]
    },
    "home-new": {
      "ask": [
        {
          "key": "where",
          "text": "Where do you live?"
        }
      ],
      "answers": [
        {
          "key": "plain",
          "text": "In {{place}}."
        },
        {
          "key": "years",
          "text": "In {{place}}, {{years}} years now.",
          "stages": ["moved"]
        },
        {
          "key": "always",
          "text": "In {{place}}. I grew up here.",
          "stages": ["born"]
        },
        {
          "key": "turn",
          "text": "In {{place}}. And you?",
          "raises": "home"
        },
        {
          "key": "brief",
          "text": "Here in {{place}}.",
          "raises": "next"
        }
      ],
      "lie": [
        {
          "key": "none",
          "text": "Not around here.",
          "stages": ["none"]
        }
      ]
    }
  }
}
