    "decline": ["refuse", "play-safe"],
    "withdraw": ["withdraw", "play-safe"],
    "bargain": ["engage", "self-interest"],
    "stall": ["delay", "play-safe"],
    "deflect": ["delay", "stay-quiet"],
    "ask": ["engage"],
    "request": ["engage", "self-interest"],
    "answer": ["speak-out", "trust"],
    "tell": ["speak-out", "trust"],
    "thank": ["cooperate"],
    "promise": ["commit", "cooperate"],
    "offer": ["help-others", "engage"],
    "comfort": ["help-others"],
    "apologize": ["concede", "help-others"],
    "blame": ["confront", "self-interest"],
    "disagree": ["confront", "speak-out"],
    "confront": ["confront", "take-risk"],
    "boast": ["speak-out", "take-risk"],
