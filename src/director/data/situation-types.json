{
  "version": "p13-director-situations-v1",
  "note": "Story director situation library on the new core (docs/design/director-on-core2.md). Ported from data/content/situation-types.json and draft pull request 3914. Structure only: no type holds a sentence; records fill every role and the English engine voices every line. Situation types are human moments only. Election night is folded into news-arrives and celebration with the elections engine as the cause; the door-knocking flow is folded into first-meeting and visit with the canvass as the reason. Each cause matches a director moment by its label, its counterpart, a thread turn or a callback reason; a cause whose producer the new core does not have yet names it in awaitingProducer and matches nothing.",
  "fills": {
    "subject": "The person whose moment opened the situation.",
    "counterpart": "The other person the opening record names.",
    "household": "The members of the subject's household that day.",
    "kin": "The subject's relatives on record.",
    "present": "Whoever else the setting's records place there that day.",
    "classmates": "People enrolled at the subject's school.",
    "coworkers": "People employed at the subject's workplace.",
    "absent": "A person tied to the subject who is away for a recorded reason or has died.",
    "authority": "The subject's guardian, teacher or supervisor on record."
  },
  "settings": {
    "home": "The subject's household home.",
    "other-home": "The counterpart's home.",
    "school": "The school the subject is enrolled at.",
    "workplace": "The subject's workplace.",
    "phone": "A call between the two.",
    "letter": "A letter or message from someone away.",
    "venue": "The place the opening record names.",
    "public": "A public place in the subject's town."
  },
  "timings": {
    "at-cause": "On the day the opening record is written.",
    "effective-date": "On the date the opening record takes effect.",
    "next-together": "The next time the roles' records place them in one setting."
  },
  "standingPulls": {
    "warmth": ["help-others", "engage", "cooperate"],
    "trust": ["trust", "cooperate"],
    "respect": ["follow-rules", "concede"],
    "commitment": ["commit", "help-others"],
    "tension": ["confront", "refuse", "distrust"]
  },
  "bearings": {
    "anxious": "Worried about what comes next.",
    "braced": "Ready for a hard exchange.",
    "calm": "Settled and unhurried.",
    "contrite": "Sorry for what they did.",
    "curious": "Wanting to know more.",
    "eager": "Keen for what is starting.",
    "glad": "Pleased by what is happening.",
    "grieving": "Mourning someone close.",
    "guarded": "Holding back, wary of the other.",
    "hopeful": "Hoping the other says yes.",
    "hurt": "Wounded by what the other did.",
    "nervous": "Uneasy at something new or exposed.",
    "proud": "Honored and pleased with themselves.",
    "relieved": "Glad something hard is over.",
    "solemn": "Grave and quiet at a serious time.",
    "steady": "Composed, holding the room.",
    "tender": "Gentle and close at a parting or in care.",
    "warm": "Friendly and open."
  },
  "scheduling": {
    "note": "Calibration, owner-adjustable (docs/design/story-director.md, part 4). paces: about how many scenes a year a life carries in each band of childhood agency, and as an adult; a moment becomes a scene when it ranks within that many of the life's moments over the trailing days, itself included. openDays: how many days a scene stays open from the date its timing sets.",
    "paces": {
      "early-childhood": 1,
      "middle-childhood": 2,
      "adolescence": 3,
      "adult": 4
    },
    "trailingDays": 365,
    "openDays": {
      "at-cause": 7,
      "effective-date": 3,
      "next-together": 30
    },
    "paceBands": [
      {
        "band": "early-childhood",
        "maxAge": 7
      },
      {
        "band": "middle-childhood",
        "maxAge": 12
      },
      {
        "band": "adolescence",
        "maxAge": 17
      },
      {
        "band": "adult"
      }
    ]
  },
