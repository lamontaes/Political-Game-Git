    "GU": {
      "membersPct": 8.0,
      "representedPct": 10.0,
      "estimate": "No official survey. Estimated from public-sector share of wage employment (~25%) times a public representation rate near the U.S. local-government level, with little private-sector coverage (teachers' and government employee unions bargain under Guam law). Spread 4-14%. Unverified snippets seen 2026-10-13: about 2% of a 154,000 workforce represented (IBEW, 2002)."
    },
    "VI": {
      "membersPct": 15.0,
      "representedPct": 17.0,
      "estimate": "No official survey. Large public sector (~30% of wage employment) with broad public-employee bargaining under the V.I. Public Employee Labor Relations Act, plus hotel and port unions. Spread 8-25%. Unverified snippet seen 2026-10-13: a federation of unions representing about 4,000 workers (St. Thomas Source)."
    },
    "AS": {
      "membersPct": 1.0,
      "representedPct": 1.0,
      "estimate": "No official survey and no known collective bargaining law for territorial government employees; the dominant private employer (tuna cannery) is not known to be unionized. Near zero; spread 0-5%."
    },
    "MP": {
      "membersPct": 1.0,
      "representedPct": 1.0,
      "estimate": "No official survey; CNMI government employees lack collective bargaining rights and the former garment-industry workforce was largely non-union. Near zero; spread 0-5%."
