{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "allowArbitraryExtensions": true,
    "allowSyntheticDefaultImports": true
  },
  "include": ["./*.ts"]
}
