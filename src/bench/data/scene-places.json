    "township-board": "public-meeting-room",
    "county-board": "council-chamber",
    "school-board": "school-board-room",
    "legislature-upper": "state-legislative-chamber-bicameral",
    "legislature-lower": "state-legislative-chamber-bicameral",
    "legislature-unicameral": "state-legislative-chamber-unicameral",
