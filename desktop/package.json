{
  "name": "our-civic-duty-desktop",
  "productName": "Our Civic Duty",
  "description": "Installed desktop client for Our Civic Duty. Wraps the compiled game; owns no game logic, no second save system, and no UI.",
  "version": "0.0.0",
  "private": true,
  "main": "main.mjs",
  "type": "commonjs",
  "scripts": {
    "stage": "node scripts/stage.mjs",
    "start": "electron .",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "dist:mac": "node scripts/stage.mjs && node scripts/package.mjs --mac --arm64",
    "dist:mac-intel": "node scripts/stage.mjs && node scripts/package.mjs --mac --x64",
    "dist:private-mac": "node scripts/stage.mjs && node scripts/package.mjs --mac --arm64 --dir -c.mac.target=dir && node scripts/package-private-controller.mjs",
    "dist:win": "node scripts/stage.mjs && node scripts/package.mjs --win --x64",
    "dist:steam": "node scripts/stage.mjs --distribution steam && node scripts/package.mjs --mac --arm64 --win --x64 -c.mac.target=dir -c.win.target=dir"
  },
  "dependencies": {
    "electron-updater": "6.6.2"
  },
  "devDependencies": {
    "electron": "38.4.0",
    "electron-builder": "26.0.12"
  }
}
